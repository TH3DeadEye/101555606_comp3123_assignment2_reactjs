# Settings for Docker Compose.
#
#   1. Copy this file to .env        (cp .env.example .env)
#   2. Fill in every empty value     (never commit .env: it is in .gitignore)
#   3. Run                           docker compose up --build
#
# Use only letters and numbers in the passwords: they become part of a
# connection URL, where characters such as @ : / # would break it.
# A good way to make one:           openssl rand -hex 16

# ---- MongoDB ----
MONGO_DB=comp3123_assignment2
# Administrator account: only used once, to set the database up
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
# The account the backend and mongo-express use (read/write on MONGO_DB only)
MONGO_APP_USER=employee_app
MONGO_APP_PASSWORD=

# ---- mongo-express (database viewer on http://localhost:8081) ----
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=

# ---- Backend ----
# Secret used to sign login tokens: at least 32 characters.  openssl rand -hex 32
JWT_SECRET=
# How long a login lasts: a number followed by s, m, h or d
JWT_EXPIRES_IN=1h

# ---- Addresses, exactly as the BROWSER uses them ----
# Where the browser finds the API (written into the frontend when it is built)
API_PUBLIC_URL=http://localhost:5001
# The frontend's address: the only origin the API accepts requests from (CORS)
CORS_ORIGIN=http://localhost:3000
