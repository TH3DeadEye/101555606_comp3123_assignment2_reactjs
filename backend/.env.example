# Copy this file to .env and adjust the values. Never commit the real .env file.

# Runtime mode: development | production | test
NODE_ENV=development

# Port the API listens on (5000 is taken by AirPlay on macOS, so 5001 is used)
PORT=5001

# MongoDB connection string. The database name must be comp3123_assignment2.
# Local MongoDB:   mongodb://127.0.0.1:27017/comp3123_assignment2
# Docker Compose:  mongodb://mongo:27017/comp3123_assignment2 (service name, not localhost)
MONGODB_URI=mongodb://127.0.0.1:27017/comp3123_assignment2

# Secret used to sign login tokens (JWT). Leave it empty here, and put a random
# value of at least 32 characters in your own .env. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# How long a login token stays valid: a number followed by s, m, h or d
# (for example 30m, 1h or 7d)
JWT_EXPIRES_IN=1h

# Frontend origin(s) allowed to call the API (CORS). Comma separated, no wildcard,
# no trailing slash. 5173 is the Vite dev server, 3000 is the Docker frontend.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting, counted per client IP address inside one time window.
# AUTH_RATE_LIMIT_MAX: failed logins (and, separately, signup requests) per window
# API_RATE_LIMIT_MAX:  all /api requests per window
# When a limit is exceeded the API answers 429 Too Many Requests.
RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# Logging: error | warn | info | debug
# Files are written to LOG_DIR as app.log (everything) and error.log (errors only)
LOG_LEVEL=info
LOG_DIR=logs
